{
  "entities": {
    "Product": {
      "title": "Product",
      "description": "Electronics showroom product",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "brand": { "type": "string" },
        "model": { "type": "string" },
        "price": { "type": "number" },
        "originalPrice": { "type": "number" },
        "stock": { "type": "number" },
        "categoryId": { "type": "string" },
        "categoryName": { "type": "string" },
        "image": { "type": "string" },
        "description": { "type": "string" },
        "isAdOffer": { "type": "boolean" },
        "emiAvailable": { "type": "boolean" },
        "monthlyEmiStarting": { "type": "number" },
        "isFeatured": { "type": "boolean" },
        "rating": { "type": "number" },
        "reviewCount": { "type": "number" }
      },
      "required": ["id", "name", "brand", "model", "price", "categoryId", "categoryName"]
    },
    "Category": {
      "title": "Category",
      "description": "Product category",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "name": { "type": "string" },
        "description": { "type": "string" },
        "productCount": { "type": "number" }
      },
      "required": ["id", "name"]
    },
    "Order": {
      "title": "Order",
      "description": "Customer order",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "totalAmount": { "type": "number" },
        "paymentMethod": { "type": "string" },
        "status": { "type": "string" },
        "createdAt": { "type": "string" }
      },
      "required": ["id", "totalAmount", "paymentMethod", "status", "createdAt"]
    },
    "StoreSettings": {
      "title": "StoreSettings",
      "description": "Showroom configuration settings",
      "type": "object",
      "properties": {
        "shopName": { "type": "string" },
        "address": { "type": "string" },
        "phone1": { "type": "string" },
        "phone2": { "type": "string" },
        "enableCod": { "type": "boolean" },
        "enableUpi": { "type": "boolean" },
        "enableBajajEmi": { "type": "boolean" },
        "announcement": { "type": "string" }
      }
    },
    "Review": {
      "title": "Review",
      "description": "Customer product review",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "productId": { "type": "string" },
        "customerName": { "type": "string" },
        "rating": { "type": "number" },
        "comment": { "type": "string" },
        "createdAt": { "type": "string" },
        "isApproved": { "type": "boolean" }
      },
      "required": ["id", "productId", "customerName", "rating", "comment"]
    }
  },
  "firestore": {
    "/products/{productId}": {
      "schema": { "$ref": "#/entities/Product" },
      "description": "Showroom products collection"
    },
    "/categories/{categoryId}": {
      "schema": { "$ref": "#/entities/Category" },
      "description": "Product categories collection"
    },
    "/orders/{orderId}": {
      "schema": { "$ref": "#/entities/Order" },
      "description": "Customer orders collection"
    },
    "/settings/{settingId}": {
      "schema": { "$ref": "#/entities/StoreSettings" },
      "description": "Store settings document"
    },
    "/reviews/{reviewId}": {
      "schema": { "$ref": "#/entities/Review" },
      "description": "Product reviews collection"
    }
  }
}
